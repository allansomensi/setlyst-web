# API Configuration
# The URL of your backend API service, as reached from the BROWSER.
# This one is inlined into the client bundle — never put a secret here.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Optional: the URL of the backend as reached from the SERVER, used by
# every server-side call and by sign-in. Set this when the server can
# reach the API on an internal address the browser can't (a private
# network, a container hostname, a service mesh); server-side calls then
# skip the public round trip. Falls back to NEXT_PUBLIC_API_URL when unset.
# API_URL=http://api.internal:8000/api/v1

# NextAuth Configuration
# The base URL of the application. Also used as the base for absolute URLs
# in social-share metadata, so it should be the real public origin in
# production.
NEXTAUTH_URL=http://localhost:3000

# A secret key used to encrypt cookies and tokens. Must be at least 32
# characters — the app refuses to start otherwise.
# You can generate a strong secret using: openssl rand -base64 32
NEXTAUTH_SECRET=your_secret
# Optional: where "Help → User guide" points (defaults to the GitHub wiki)
# NEXT_PUBLIC_WIKI_URL=https://github.com/allansomensi/setlyst-web/wiki

# Contact shown for account help, data requests, withdrawal requests and
# security reports (legal pages, forgot-password screen, share-lock notices)
# NEXT_PUBLIC_SUPPORT_EMAIL=contato@setlyst.com.br

# Optional: public site and legal documents
# Fallback only: the site reads the beta switch from the API
# (GET /public/billing, the "Enforce plans" setting in the admin panel) and
# uses this while the API can't be reached. "true" = plans enforced.
# NEXT_PUBLIC_BILLING_ENFORCED=false
# Privacy channel for data subjects and the ANPD (LGPD art. 41). Setlyst is
# run as a small-scale processing agent without an appointed encarregado
# (Resolução CD/ANPD nº 2/2022, art. 11): this mailbox is the channel, under
# the controller's responsibility. Falls back to NEXT_PUBLIC_SUPPORT_EMAIL;
# set a real mailbox in production.
# NEXT_PUBLIC_PRIVACY_EMAIL=privacidade@setlyst.com.br
# Dedicated, permanently available channel for copyright notices,
# counter-notices and reports about public links (Copyright Policy §5, the
# /contato page and the "Report content" link on /s and /g). Falls back to
# NEXT_PUBLIC_SUPPORT_EMAIL.
# NEXT_PUBLIC_COPYRIGHT_EMAIL=direitosautorais@setlyst.com.br
# Who runs Setlyst, shown in the site footer, the /contato page, the Terms,
# the Privacy Policy and the Subscription Terms (LGPD art. 41, Decreto
# 7.962/2013 art. 2º): full name (or company name), CPF (or CNPJ) and a
# postal address where mail is received. An 11-digit tax id is worded as an
# individual (pessoa física, CPF), a 14-character one as a company (CNPJ,
# numeric or alphanumeric). REQUIRED for production: `next build` fails
# while any of them is missing or the CPF/CNPJ check digits are invalid.
# Changes need a new build.
# (The older NEXT_PUBLIC_COMPANY_NAME / _CNPJ / _ADDRESS are still read.)
NEXT_PUBLIC_CONTROLLER_NAME=
NEXT_PUBLIC_CONTROLLER_TAX_ID=
NEXT_PUBLIC_CONTROLLER_ADDRESS=
# Only for CI builds that are never deployed: lets `next build` run with
# the placeholders above.
# ALLOW_PLACEHOLDER_CONTROLLER=true

# Shared secret identifying this server to the API (same value as the API's
# INTERNAL_API_SECRET): lets the API rate-limit and audit by the visitor's
# address instead of this server's.
# INTERNAL_API_SECRET=

# Which forwarding headers tell the visitor's address (only used with
# INTERNAL_API_SECRET). On Vercel (VERCEL is set by the platform) the
# x-vercel-forwarded-for / x-real-ip headers are used and these are ignored.
# Self-hosted: the number of reverse proxies you run in front of Next.js,
# each appending to X-Forwarded-For. The visitor is the entry this many
# positions from the RIGHT (the leftmost one is written by the client and
# never trusted). 0 disables X-Forwarded-For. Default 0 (no proxy trusted;
# the server logs a warning at startup when INTERNAL_API_SECRET is set and
# neither this nor TRUST_X_REAL_IP is).
# TRUSTED_PROXY_HOPS=1
# Set to "true" only if your proxy OVERWRITES X-Real-IP with the peer
# address (e.g. nginx `proxy_set_header X-Real-IP $remote_addr;`).
# TRUST_X_REAL_IP=false

# Optional: register the service worker under `next dev` too (it pre-caches
# every page, which makes the dev server very slow). Off by default.
# NEXT_PUBLIC_ENABLE_SW_IN_DEV=false

# Optional: "Continuar com Google". The button only appears when both are
# set; the API must list the same client id in GOOGLE_CLIENT_IDS. Authorized
# redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
